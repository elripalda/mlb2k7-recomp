diff --git a/cmake/rex_version.cmake b/cmake/rex_version.cmake
index 03d6663..fc56b96 100644
--- a/cmake/rex_version.cmake
+++ b/cmake/rex_version.cmake
@@ -113,6 +113,12 @@ function(rex_resolve_version out_var)
         set(ARG_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
     endif()
 
+    # MLB2K7: source zip has no git history, so take the version from the command line.
+    if(REXGLUE_VERSION_OVERRIDE)
+        set(${out_var} "${REXGLUE_VERSION_OVERRIDE}" PARENT_SCOPE)
+        return()
+    endif()
+
     find_program(GIT_EXECUTABLE git)
     if(NOT GIT_EXECUTABLE)
         rex_compute_version(result
