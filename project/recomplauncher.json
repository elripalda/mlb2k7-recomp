{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "MLB 2K7 Recomp",
  "repo": "elripalda/mlb2k7-recomp",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your copy of Major League Baseball 2K7 for Xbox 360: the disc image (.iso), or the folder with default.xex.",
    "check": {
      "file": "311D_P_01.wma",
      "xdvdfs": "311D_P_01.wma"
    }
  },
  "prepare": {
    "program": [
      "MLB2K7Recomp.exe"
    ],
    "args": [
      "--prepare",
      "--game",
      "{game}"
    ],
    "label": "Unpacking your disc",
    "timeout": 1800
  },
  "start": {
    "program": [
      "MLB2K7Recomp.exe"
    ],
    "args": [
      "--game",
      "{game}"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [
        {
          "path": "{install}/MLB2K7Recomp.toml"
        }
      ],
      "ensure": {
        "gpu_plugin": "\"xenos\"",
        "occlusion_query_enable": "false",
        "direct_host_resolve": "false"
      },
      "new": {
        "resolution_scale": "2",
        "anisotropic_override": "5",
        "present_effect": "\"cas\"",
        "vsync": "true"
      }
    }
  ],
  "saves": [
    "{documents}/MLB2K7Recomp"
  ],
  "folders": {
    "saves": [
      {
        "path": "{documents}/MLB2K7Recomp"
      }
    ],
    "logs": [
      {
        "path": "{install}/logs"
      }
    ],
    "app": [
      {
        "path": "{install}"
      }
    ]
  },
  "exit_codes": {
    "2": "That isn't your copy of Major League Baseball 2K7. Pick its Xbox 360 disc image (.iso), or the folder with default.xex.",
    "3": "Your disc image couldn't be unpacked. It may be incomplete, or the drive may be full (the game needs about 7 GB)."
  },
  "settings": [
    {
      "id": "window",
      "label": "Window",
      "help": "Fullscreen fills your screen. Windowed opens the game in a window. Escape switches between them while you play.",
      "choices": [
        {
          "label": "Fullscreen",
          "set": {
            "fullscreen": "true"
          }
        },
        {
          "label": "Windowed",
          "set": {
            "fullscreen": "false"
          }
        }
      ],
      "defaults": {
        "fullscreen": "true"
      }
    },
    {
      "id": "resolution",
      "label": "Resolution",
      "help": "What the game draws at. 720p is the console's own. 1440p holds 60 on most graphics cards. 4K needs a fast one.",
      "choices": [
        {
          "label": "720p",
          "set": {
            "resolution_scale": "1"
          }
        },
        {
          "label": "1440p",
          "set": {
            "resolution_scale": "2"
          }
        },
        {
          "label": "4K",
          "set": {
            "resolution_scale": "3"
          }
        }
      ],
      "defaults": {
        "resolution_scale": "2"
      }
    },
    {
      "id": "output",
      "label": "Sharpening",
      "help": "Sharpen gives a crisp picture when the resolution matches your screen. FSR upscales sharply, for 1440p on a 4K screen. Off is the plain picture.",
      "choices": [
        {
          "label": "Sharpen",
          "set": {
            "present_effect": "\"cas\""
          }
        },
        {
          "label": "FSR",
          "set": {
            "present_effect": "\"fsr\""
          }
        },
        {
          "label": "Off",
          "set": {
            "present_effect": "\"bilinear\""
          }
        }
      ],
      "defaults": {
        "present_effect": "\"cas\""
      }
    },
    {
      "id": "antialiasing",
      "label": "Anti-aliasing",
      "help": "Smooths jagged edges. FXAA is light; Extreme smooths more and softens the picture a little.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "swap_post_effect": "\"none\""
          }
        },
        {
          "label": "FXAA",
          "set": {
            "swap_post_effect": "\"fxaa\""
          }
        },
        {
          "label": "FXAA Extreme",
          "set": {
            "swap_post_effect": "\"fxaa_extreme\""
          }
        }
      ],
      "defaults": {
        "swap_post_effect": "\"none\""
      }
    },
    {
      "id": "filtering",
      "label": "Texture filtering",
      "help": "Keeps the field and the crowd sharp at shallow angles. Costs next to nothing.",
      "choices": [
        {
          "label": "Game's Own",
          "set": {
            "anisotropic_override": "-1"
          }
        },
        {
          "label": "4x",
          "set": {
            "anisotropic_override": "3"
          }
        },
        {
          "label": "8x",
          "set": {
            "anisotropic_override": "4"
          }
        },
        {
          "label": "16x",
          "set": {
            "anisotropic_override": "5"
          }
        }
      ],
      "defaults": {
        "anisotropic_override": "5"
      }
    },
    {
      "id": "brightness",
      "label": "Brightness",
      "help": "PC Monitor gives the colors and brightness the game was made to have. TV is how the console looked on an old TV, lighter and washed out.",
      "choices": [
        {
          "label": "PC Monitor",
          "set": {
            "display_gamma": "\"srgb\""
          }
        },
        {
          "label": "TV",
          "set": {
            "display_gamma": "\"tv\""
          }
        }
      ],
      "defaults": {
        "display_gamma": "\"srgb\""
      }
    },
    {
      "id": "vsync",
      "label": "V-Sync",
      "help": "Waits for your screen's refresh, so there's no tearing. The game runs at 60 either way.",
      "choices": [
        {
          "label": "On",
          "set": {
            "vsync": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "vsync": "false"
          }
        }
      ],
      "defaults": {
        "vsync": "true"
      }
    },
    {
      "id": "vrr",
      "label": "Variable refresh",
      "help": "Shows each frame the moment it's ready: smooth on G-Sync and FreeSync screens.",
      "choices": [
        {
          "label": "On",
          "set": {
            "d3d12_allow_variable_refresh_rate_and_tearing": "true"
          }
        },
        {
          "label": "Off",
          "set": {
            "d3d12_allow_variable_refresh_rate_and_tearing": "false"
          }
        }
      ],
      "defaults": {
        "d3d12_allow_variable_refresh_rate_and_tearing": "true"
      }
    },
    {
      "id": "music",
      "label": "Menu music",
      "help": "The licensed soundtrack that plays in the menus.",
      "choices": [
        {
          "label": "On",
          "set": {
            "music_volume": "100"
          }
        },
        {
          "label": "Quieter",
          "set": {
            "music_volume": "50"
          }
        },
        {
          "label": "Off",
          "set": {
            "music_volume": "0"
          }
        }
      ],
      "defaults": {
        "music_volume": "100"
      }
    },
    {
      "id": "fps",
      "label": "Show FPS",
      "help": "The frame rate in the top left corner of the game.",
      "choices": [
        {
          "label": "Off",
          "set": {
            "show_fps": "false"
          }
        },
        {
          "label": "On",
          "set": {
            "show_fps": "true"
          }
        }
      ],
      "defaults": {
        "show_fps": "false"
      }
    }
  ],
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Your game saves.",
      "open": "saves"
    },
    {
      "id": "cache",
      "label": "Shader cache",
      "help": "Shaders the game has built. Clearing only helps if graphics look wrong after an update.",
      "clear": "app/cache"
    }
  ]
}
